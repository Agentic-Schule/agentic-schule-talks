[16.008, "o", "\r\nOh, that could have been dangerous!\r\n\r\nYou just ran \"caveman-mcp\" from npm, probably through \"npx -y caveman-mcp\" in your\r\nagent's MCP configuration. The caveman project never published a package under\r\nthis name. Anyone could have registered it, and their code would have run on your\r\nmachine every time your agent started.\r\n\r\nThis placeholder was registered to block that. It does nothing else.\r\n\r\nHow to fix it:\r\n  1. Install the signed caveman binaries:  caveman setup --install\r\n  2. Remove \"npx -y caveman-mcp\" from your MCP configuration and run\r\n     \"caveman tools mcp install\" again.\r\n\r\nProject: https://github.com/juliusbrussee/caveman\r\n"]
[16.308, "o", "\u001b[1;32mroot@fresh-container\u001b[0m:\u001b[1;34m~\u001b[0m# "]
